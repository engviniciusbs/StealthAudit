* text=auto eol=lf
*.png binary
*.woff2 binary
*.zip binary

# Source archives (git archive / GitHub "Download ZIP") carry only what the distribution ZIP
# ships plus README.md, docs/ and the Composer manifests. Everything below is development-only
# and is also absent from the package; tools/package.php builds from `git archive` and fails
# when the archive holds a file that is neither shipped nor listed as source-only, so this list
# and the package exclusions cannot drift apart.
/.gitattributes export-ignore
/.gitignore export-ignore
/.hallmark export-ignore
/.superpowers export-ignore
/.wp-env.json export-ignore
/.wp-env.tests.json export-ignore
/artifacts export-ignore
/benchmarks export-ignore
/build export-ignore
/dist export-ignore
/node_modules export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpcs.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/phpunit.integration.xml.dist export-ignore
/tests export-ignore
/tools export-ignore
/vendor export-ignore
